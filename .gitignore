# NEW: Root-level gitignore for repo-wide ignores.
# (Per-project ignores live in backend/.gitignore and frontend/.gitignore)

# Secrets — must never be committed
# .env       → production config (used by run.sh / docker-compose.prod.yml)
# .env.local → developer overrides (loaded by backend/settings.py + Next.js)
.env
.env.local

# OS artifacts
.DS_Store
Thumbs.db

# Audit output directory (generated by Phase 6 browser audits)
audits/

# Claude-generated plans and memory (local to each developer's machine)
.claude/
.gstack/

# Runtime caches — never commit (download cache, preprocessing cache, vision OCR cache)
backend/temp/
