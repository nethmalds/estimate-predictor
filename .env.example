# Production environment template.
# Copy to .env and fill in all values before running ./run.sh up
# .env is gitignored — never commit real secrets.
# For local development, see .env.local.example and backend/.env.local.example instead.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── ChromaDB / RAG ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
MIN_CONFIDENCE_THRESHOLD=0.5

# ── Ollama Cloud ─────────────────────────────────────────────────────────────
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_HOST=https://ollama.com

# ── Backend secrets ──────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
API_SECRET_KEY=
# First origin is used for auth email links.
CORS_ALLOW_ORIGINS=http://estimate

# ── SMTP (for forgot-password and email verification emails) ─────────────────
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://estimate
NEXT_PUBLIC_APP_URL=http://estimate
# Generate: openssl rand -base64 32
AUTH_SECRET=
UPLOADTHING_TOKEN=

# ── Redis ────────────────────────────────────────────────────────────────────
# In Docker Compose prod this is auto-set to redis://redis:6379/0
# For local dev: leave blank (falls back to in-process) or set to redis://localhost:6379/0
REDIS_URL=

# ── Caddy / TLS ──────────────────────────────────────────────────────────────
# Set to http://estimate for the single-label HTTP production host.
# Set to a public domain for auto-TLS (e.g. example.com).
# Set to :80 for a local / VPN-only run with no TLS on any host.
DOMAIN=http://estimate
