# NEW: Caddy reverse proxy configuration.
# DOMAIN env var is injected by docker-compose.prod.yml from .env.
# If DOMAIN=example.com, Caddy auto-provisions a Let's Encrypt TLS cert.
# If DOMAIN=:80, Caddy serves plain HTTP (useful for local/VPN-only runs).

{$DOMAIN} {
    encode zstd gzip

    # NEW: Route backend-bound traffic — API, health, and OpenAPI docs
    @api path /api/* /health /docs /openapi.json
    handle @api {
        reverse_proxy backend:8000
    }

    # NEW: Everything else goes to the Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }
}
