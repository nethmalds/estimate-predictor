# Development environment overrides (repo root).
# Copy to .env.local — it is gitignored and will never be committed.
#
# These values override .env when running docker compose locally.
# For backend-only dev (uvicorn + npm run dev), use backend/.env.local instead.
# For frontend-only dev, use frontend/.env.local instead.
#
# Usage: docker compose --env-file .env.local -f docker-compose.prod.yml up -d
#        (or just run the services from backend/docker/docker-compose.yml for dev infra)

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=estimator
POSTGRES_PASSWORD=estimator_dev
POSTGRES_DB=estimator_dev

# ── ChromaDB / RAG ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
MIN_CONFIDENCE_THRESHOLD=0.45

# ── Ollama Cloud ──────────────────────────────────────────────────────────────
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=https://ollama.com

# ── Backend secrets ───────────────────────────────────────────────────────────
# Any non-empty string works for dev
API_SECRET_KEY=dev-secret-change-in-production
# First origin is used for auth email links.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── SMTP → Gmail SMTP ────────────────────────────────────────────────────────
# Use a Gmail app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=CostEstimate AI
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_STARTTLS=true
SMTP_SSL=false

# ── Redis (session store) ────────────────────────────────────────────────────
# Included in backend/docker/docker-compose.yml
REDIS_URL=redis://localhost:6379/0

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate: openssl rand -base64 32
AUTH_SECRET=dev-auth-secret-change-in-production
UPLOADTHING_TOKEN=your-uploadthing-token

# ── Caddy / TLS ───────────────────────────────────────────────────────────────
DOMAIN=:80
